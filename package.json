{
  "name": "orbit-homes",
  "version": "1.0.0",
  "description": "Property Management System for Landlords and Real Estate Agencies in Africa",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --x64",
    "pack": "electron-builder --dir"
  },
  "build": {
    "appId": "com.orbithomes.app",
    "productName": "Orbit Homes",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "keywords": [
    "property",
    "management",
    "landlord",
    "africa",
    "real-estate"
  ],
  "author": "Orbit Homes",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.3.3",
    "electron-builder": "^24.0.0"
  }
}
